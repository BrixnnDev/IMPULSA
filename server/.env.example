# ===== Servidor StockFlow =====
PORT=8787

# ---- WhatsApp Cloud API (Meta) ----
# 1. https://developers.facebook.com -> Crear app -> tipo "Negocio"
# 2. Agregar producto "WhatsApp" -> API Setup
# 3. Copiar el "Access token" temporal y el "Phone number ID"
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Inventate una clave cualquiera; la misma debes poner en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=stockflow-verify-123

# ---- Gmail (Google Cloud OAuth2) ----
# 1. https://console.cloud.google.com -> Nuevo proyecto
# 2. APIs y servicios -> Habilitar "Gmail API"
# 3. Pantalla de consentimiento OAuth (tipo Externo, agrega tu correo como tester)
# 4. Credenciales -> Crear ID de cliente OAuth -> Aplicacion web
#    URI de redireccion autorizada: http://localhost:8787/api/gmail/oauth2callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/gmail/oauth2callback
